# =============================================================================
# Domain
# =============================================================================
DOMAIN=example.com

SUPERSET_SUBDOMAIN=superset
AIRFLOW_SUBDOMAIN=airflow
GRAFANA_SUBDOMAIN=grafana

SUPERSET_DASHBOARD_PATH=/superset/dashboard/itvacancies/?standalone=2


# =============================================================================
# Container hostnames
# =============================================================================
HOST_APP_POSTGRES=app-postgres
HOST_AIRFLOW_POSTGRES=airflow-postgres
HOST_SUPERSET_POSTGRES=superset-postgres
HOST_CLICKHOUSE=clickhouse
HOST_AIRFLOW_WEBSERVER=airflow-webserver
HOST_SUPERSET=superset
HOST_GRAFANA=grafana
HOST_NLP=nlp
HOST_NAMENODE=namenode
HOST_SPARK_MASTER=spark-master
HOST_STATSD=statsd-exporter


# =============================================================================
# Host-side ports
# =============================================================================
PORT_HTTP=80
PORT_HTTPS=443
PORT_AIRFLOW=11080
PORT_SPARK_MASTER=12080
PORT_NAMENODE=13870
PORT_APP_POSTGRES=14432
PORT_NLP=15000
PORT_PROMETHEUS=15090
PORT_GRAFANA=16000
PORT_SUPERSET=16088
PORT_CLICKHOUSE_HTTP=18123
PORT_CLICKHOUSE_TCP=19000


# =============================================================================
# App Postgres
# =============================================================================
PG_USER=postgres
PG_PASS=1234
PG_DB=vacstorage


# =============================================================================
# ClickHouse
# =============================================================================
CH_USER=admin
CH_PASS=1234
CH_DB=analytics


# =============================================================================
# Airflow
# =============================================================================
AIRFLOW_UID=1000

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
# openssl rand -base64 42
AIRFLOW__WEBSERVER__SECRET_KEY=

# Airflow metadata postgres
AIRFLOW_PG_USER=airflow
AIRFLOW_PG_PASS=airflow
AIRFLOW_PG_DB=airflow

# Airflow UI admin
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# SMTP для уведомлений о падениях DAG
AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
AIRFLOW__SMTP__SMTP_STARTTLS=True
AIRFLOW__SMTP__SMTP_SSL=False
AIRFLOW__SMTP__SMTP_USER=your@gmail.com
AIRFLOW__SMTP__SMTP_PASSWORD=
AIRFLOW__SMTP__SMTP_PORT=587


# =============================================================================
# Superset
# =============================================================================
# Superset metadata postgres
SUPERSET_PG_USER=superset
SUPERSET_PG_PASS=superset
SUPERSET_PG_DB=superset

# openssl rand -base64 42
SUPERSET_SECRET_KEY=
# Mapbox token для карт (опционально), https://account.mapbox.com
MAPBOX_API_KEY=


SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_FIRSTNAME=Admin
SUPERSET_ADMIN_LASTNAME=User


# =============================================================================
# Grafana
# =============================================================================
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
