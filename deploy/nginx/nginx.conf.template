worker_processes auto;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    sendfile           on;
    tcp_nopush         on;
    tcp_nodelay        on;
    keepalive_timeout  65;
    types_hash_max_size 2048;

    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml
        font/woff2;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';
    access_log /var/log/nginx/access.log main;
    error_log  /var/log/nginx/error.log  warn;

    limit_req_zone $binary_remote_addr zone=general:10m rate=15r/s;
    limit_req_zone $binary_remote_addr zone=login:10m rate=3r/s;
    limit_req_status 429;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;

    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    server {
        listen 80 default_server;
        server_name _;

        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 443 ssl;
        server_name ${DOMAIN} www.${DOMAIN};

        include /etc/nginx/snippets/ssl-params.conf;
        include /etc/nginx/snippets/security-headers.conf;
        add_header X-Frame-Options "SAMEORIGIN" always;

        client_max_body_size 200m;
        limit_req zone=general burst=30 nodelay;

        set $superset_upstream "${SUPERSET_UPSTREAM}";

        location = /robots.txt {
            default_type text/plain;
            return 200 'User-agent: *
Allow: /
Sitemap: https://${DOMAIN}/sitemap.xml
';
        }

        location = /sitemap.xml {
            default_type application/xml;
            return 200 '<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://${DOMAIN}/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
';
        }

        location = / {
            default_type text/html;
            charset utf-8;
            return 200 '<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>IT Vacancies — аналитика рынка IT-вакансий: зарплаты, навыки, работодатели</title>
<meta name="description" content="Открытый дашборд аналитики IT-рынка труда: 47 000+ вакансий с HeadHunter, HabrCareer, GetMatch, GeekJob и других площадок. Медианные зарплаты, востребованные навыки, грейды, работодатели и география. Данные обновляются ежедневно.">
<meta name="keywords" content="IT вакансии, аналитика IT рынка, зарплаты в IT, статистика вакансий, навыки разработчиков, рынок труда IT">
<link rel="canonical" href="https://${DOMAIN}/">
<meta property="og:type" content="website">
<meta property="og:title" content="IT Vacancies — аналитика рынка IT-вакансий">
<meta property="og:description" content="Открытый дашборд: зарплаты, навыки, работодатели и география по 47 000+ IT-вакансий. Обновляется ежедневно.">
<meta property="og:url" content="https://${DOMAIN}/">
<meta name="twitter:card" content="summary_large_image">
<!-- Подтверждение прав в вебмастер-панелях: раскомментируйте и вставьте свои коды -->
<!-- <meta name="google-site-verification" content="ВСТАВЬТЕ_КОД_GOOGLE"> -->
<!-- <meta name="yandex-verification" content="ВСТАВЬТЕ_КОД_YANDEX"> -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "IT Vacancies",
  "url": "https://${DOMAIN}/",
  "description": "Открытый дашборд аналитики IT-рынка труда: медианные зарплаты, востребованные навыки, грейды, работодатели и география по 47 000+ IT-вакансий с HeadHunter, HabrCareer, GetMatch, GeekJob и других площадок."
}
</script>
<style>*{margin:0;padding:0}html,body,iframe{width:100%;height:100%;border:none;overflow:hidden}</style>
</head>
<body>
<iframe src="${SUPERSET_DASHBOARD_PATH}" title="Дашборд аналитики IT-вакансий" allowfullscreen></iframe>
</body>
</html>';
        }

        location / {
            proxy_pass http://$superset_upstream;
            proxy_set_header Upgrade    $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_read_timeout  300s;
            proxy_send_timeout  300s;
        }
    }

    server {
        listen 443 ssl;
        server_name ${SUPERSET_SUBDOMAIN}.${DOMAIN};

        include /etc/nginx/snippets/ssl-params.conf;
        include /etc/nginx/snippets/security-headers.conf;
        add_header X-Frame-Options "DENY" always;

        client_max_body_size 200m;
        limit_req zone=general burst=30 nodelay;

        set $superset_upstream "${SUPERSET_UPSTREAM}";

        location = /robots.txt {
            default_type text/plain;
            return 200 'User-agent: *
Disallow: /
';
        }

        location /login {
            limit_req zone=login burst=5 nodelay;
            proxy_pass http://$superset_upstream;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }


        location / {
            proxy_pass http://$superset_upstream;
            proxy_set_header Upgrade    $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_read_timeout  300s;
            proxy_send_timeout  300s;
        }
    }

    server {
        listen 443 ssl;
        server_name ${AIRFLOW_SUBDOMAIN}.${DOMAIN};

        include /etc/nginx/snippets/ssl-params.conf;
        include /etc/nginx/snippets/security-headers.conf;
        add_header X-Frame-Options "DENY" always;

        limit_req zone=general burst=20 nodelay;

        set $airflow_upstream "${AIRFLOW_UPSTREAM}";

        location = /robots.txt {
            default_type text/plain;
            return 200 'User-agent: *
Disallow: /
';
        }

        location /login {
            limit_req zone=login burst=5 nodelay;
            proxy_pass http://$airflow_upstream;
        }

        location / {
            proxy_pass http://$airflow_upstream;
            proxy_set_header Upgrade    $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_read_timeout  300s;
            proxy_send_timeout  300s;
        }
    }

    server {
        listen 443 ssl;
        server_name ${GRAFANA_SUBDOMAIN}.${DOMAIN};

        include /etc/nginx/snippets/ssl-params.conf;
        include /etc/nginx/snippets/security-headers.conf;
        add_header X-Frame-Options "DENY" always;

        limit_req zone=general burst=20 nodelay;

        set $grafana_upstream "${GRAFANA_UPSTREAM}";

        location = /robots.txt {
            default_type text/plain;
            return 200 'User-agent: *
Disallow: /
';
        }

        location /login {
            limit_req zone=login burst=5 nodelay;
            proxy_pass http://$grafana_upstream;
        }

        location / {
            proxy_pass http://$grafana_upstream;
            proxy_set_header Upgrade    $http_upgrade;
            proxy_set_header Connection "upgrade";
        }
    }

    server {
        listen 443 ssl default_server;
        server_name _;

        ssl_certificate     /etc/nginx/ssl/fullchain.pem;
        ssl_certificate_key /etc/nginx/ssl/privkey.pem;

        return 444;
    }
}
